# Copy to .env at the project root, beside package.json.
# Supabase project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=
# Use the legacy anon public JWT key for the existing analyze request.
# Never use a service_role or secret key here.
VITE_SUPABASE_ANON_KEY=

# Optional public test-mode key ID, e.g. rk_test_...
VITE_RAZORPAY_KEY_ID=

# Server only: matching Razorpay TEST key secret; live key IDs are rejected.
RAZORPAY_KEY_SECRET=

# Server only: optional AI business-plan generation.
GROQ_API_KEY=
# Optional model override; blank uses the server's default.
GROQ_MODEL=

# Server only: optional image text extraction.
COHERE_API_KEY=
COHERE_MODEL=
